# Copier en .env pour le développement local (jamais commité).
ANTHROPIC_API_KEY=            # obligatoire pour /api/chat (sans elle : 501)
ANTHROPIC_MODEL=claude-sonnet-4-6   # recommandé : claude-sonnet-5-5 ou claude-opus-5-5
ANTHROPIC_MAX_TOKENS=8192
ANTHROPIC_TIMEOUT_MS=60000
PORT=8080
# ALLOWED_ORIGINS=https://mon-frontend.exemple   # seulement si le frontend est hébergé ailleurs
# ORIGINES_REGEX=
# FRONTEND_DIR=none                               # ne pas servir public/
